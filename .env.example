# ─── Google Drive Ingestion (Read Videos & Assets) ─────────────────────────
GDRIVE_REFRESH_TOKEN=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_PARENT_FOLDER_ID=1Fhklu9lezMFTAGPdBC32bgVxel5ZLE9o

# ─── YouTube Data API v3 (Upload & Schedule Videos) ────────────────────────
# Can reuse the same Google Cloud Client ID & Secret or a dedicated one
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ─── Groq AI Metadata Generation (Viral Titles & Descriptions) ─────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Publication & Scheduling Settings ────────────────────────────────────
# Privacy status: "public", "unlisted", or "private"
YOUTUBE_PRIVACY_STATUS=public

# Category ID: 27 (Education), 22 (People & Blogs), 24 (Entertainment)
YOUTUBE_CATEGORY_ID=27

# Channel Language: "en" or "hi"
YOUTUBE_DEFAULT_LANGUAGE=en

# Auto-scheduling: Set to true if you want videos scheduled for prime hours
YOUTUBE_AUTO_SCHEDULE=false
# Preferred schedule hour in IST (24h format, e.g. 10 for 10 AM, 18 for 6 PM)
YOUTUBE_SCHEDULE_HOUR_IST=18
